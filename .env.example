# Copy to .env.local and fill in. Never commit .env.local.

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Tavily web search — https://app.tavily.com
TAVILY_API_KEY=

# Optional. OpenRouter model slug for the agent; must support tool calling.
# Defaults to moonshotai/kimi-k2:free.
# Note: OpenRouter retires free variants without notice — as of this writing
# the ":free" Kimi K2 slug is no longer served and returns
# "This model is unavailable for free." Working alternatives include
# moonshotai/kimi-k2 (paid) and nvidia/nemotron-3.5-super-vl:free.
OPENROUTER_MODEL=
